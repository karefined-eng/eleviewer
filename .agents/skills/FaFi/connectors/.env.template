# =====================================================
# FassadenFix Konnektoren - Umgebungsvariablen
# =====================================================
# Kopiere diese Datei als .env und trage die Werte ein.
# ACHTUNG: .env niemals in Git committen!

# === HERO Software (GraphQL API) ===
# API-Key beim HERO Support anfordern
HERO_API_KEY=

# === Sipgate VoIP (REST API) ===
# Personal Access Token: https://app.sipgate.com/personal-access-token
SIPGATE_TOKEN_ID=
SIPGATE_TOKEN=

# === WhatsApp Business (Meta Cloud API) ===
# Setup: https://developers.facebook.com/docs/whatsapp/cloud-api/get-started
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# === Google Ads (MCP Server) ===
# Setup: https://developers.google.com/google-ads/api/docs/get-started
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# === Ricoh360 Tours (Cloud API) ===
# API-Key: Ricoh360 Dashboard > Team Settings > API
RICOH360_API_KEY=

# === Make.com (Automatisierung) ===
# API Token: Make.com > Profil > API
MAKE_API_TOKEN=
MAKE_TEAM_ID=
MAKE_ZONE=eu1
