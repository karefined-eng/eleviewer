{
  "manifest_version": "1.0",
  "type": "skill",
  "name": "ff_inspektion",
  "version": "1.0.0",
  "description": "Fuehrt den jaehrlichen Inspektionsprozess fuer Fassaden durch. Verwenden fuer: digitale Inspektionsprotokolle, Zustandserfassung mit Bewertungsskala, Fotodokumentation von Schaeden und Erstellung von Inspektionsberichten.",
  "author": "FassadenFix",
  "tags": [
    "inspektion",
    "fassade",
    "garantie",
    "protokoll",
    "pdf",
    "bewertung",
    "schaeden",
    "fassadenfix"
  ],
  "capabilities": [
    "inspection",
    "pdf_generation",
    "form_processing",
    "photo_upload",
    "rating_scale",
    "digital_signature"
  ],
  "implementation": {
    "language": "python",
    "entrypoint": "main.py"
  },
  "interface": {
    "inputs": [
      {
        "name": "projektnummer",
        "type": "string",
        "description": "Eindeutige Projektnummer",
        "required": true
      },
      {
        "name": "auftraggeber",
        "type": "string",
        "description": "Name des Auftraggebers",
        "required": true
      },
      {
        "name": "anschrift",
        "type": "string",
        "description": "Vollstaendige Adresse des Objekts",
        "required": true
      },
      {
        "name": "zustand_fassade",
        "type": "integer",
        "description": "Bewertung des Fassadenzustands (0-4)",
        "required": true,
        "minimum": 0,
        "maximum": 4
      },
      {
        "name": "schaeden",
        "type": "array",
        "description": "Liste der dokumentierten Schaeden",
        "required": false,
        "default": []
      },
      {
        "name": "gefahren",
        "type": "array",
        "description": "Liste weiterer Gefahren",
        "required": false,
        "default": []
      },
      {
        "name": "empfehlungen",
        "type": "string",
        "description": "Empfohlene Massnahmen",
        "required": false
      },
      {
        "name": "pruefer_name",
        "type": "string",
        "description": "Name des Pruefers",
        "required": true
      }
    ],
    "outputs": [
      {
        "name": "inspektionsdaten_json",
        "type": "object",
        "description": "Strukturierte Inspektionsdaten als JSON"
      },
      {
        "name": "pdf_path",
        "type": "string",
        "description": "Pfad zum generierten PDF-Protokoll"
      },
      {
        "name": "nacharbeiten_erforderlich",
        "type": "boolean",
        "description": "Ob Nacharbeiten erforderlich sind (Zustand >= 3)"
      },
      {
        "name": "success",
        "type": "boolean",
        "description": "Ob die Inspektion erfolgreich dokumentiert wurde"
      }
    ]
  },
  "dependencies": [
    "fassadenfix_branding"
  ],
  "orchestration": {
    "default_enabled": false,
    "priority": 50,
    "scope": "project",
    "auto_inject": false
  },
  "metadata": {
    "created_at": "2026-02-02T12:00:00Z",
    "updated_at": "2026-02-02T12:00:00Z",
    "license": "Proprietary - FassadenFix GmbH",
    "documentation": "SKILL.md",
    "original_template": "FF-INS-001_Inspektionsprotokoll.pdf"
  }
}
