{
  "manifest_version": "1.0",
  "type": "agent",
  "name": "fassadenfix_marketing_agent",
  "version": "1.0.0",
  "description": "Erstellt und koordiniert FassadenFix Marketing-Kampagnen durch Orchestrierung aller Marketing-Skills. Verwenden für: Kampagnen-Planung, Content-Koordination, Multi-Channel-Marketing, Markenkonformitätsprüfung.",
  "author": "FassadenFix",
  "tags": [
    "strategy",
    "campaign",
    "fassadenfix",
    "marketing"
  ],
  "capabilities": [
    "campaign_management",
    "marketing"
  ],
  "implementation": {
    "language": "python",
    "entrypoint": "main.py"
  },
  "interface": {
    "inputs": [
      {
        "name": "input",
        "type": "string",
        "description": "Eingabe für den Skill",
        "required": true
      }
    ],
    "outputs": [
      {
        "name": "output",
        "type": "string",
        "description": "Ausgabe des Skills"
      }
    ]
  },
  "dependencies": [],
  "metadata": {
    "created_at": "2026-02-02T00:00:00Z",
    "updated_at": "2026-02-02T00:00:00Z",
    "license": "Proprietary - FassadenFix GmbH",
    "documentation": "SKILL.md"
  },
  "platforms": [
    "claude",
    "manus",
    "chatgpt_codex",
    "gemini",
    "antigravity"
  ],
  "orchestration": {
    "default_enabled": true,
    "priority": 100,
    "scope": "global",
    "auto_inject": true
  }
}