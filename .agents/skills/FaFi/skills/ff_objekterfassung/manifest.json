{
  "manifest_version": "1.0",
  "type": "skill",
  "name": "ff_objekterfassung",
  "version": "1.0.0",
  "description": "Digitalisiert die Objekterfassung fuer Fassadenprojekte. Verwenden fuer: Erfassung von Objektdaten, Zustandsdokumentation vor Ort, Foto-Uploads, automatische Flaechenberechnung und PDF-Generierung.",
  "author": "FassadenFix",
  "tags": [
    "objekterfassung",
    "fassade",
    "dokumentation",
    "pdf",
    "formular",
    "baustelle",
    "projekt",
    "fassadenfix"
  ],
  "capabilities": [
    "data_capture",
    "pdf_generation",
    "form_processing",
    "photo_upload",
    "calculation"
  ],
  "implementation": {
    "language": "python",
    "entrypoint": "main.py"
  },
  "interface": {
    "inputs": [
      {
        "name": "anschrift",
        "type": "string",
        "description": "Vollstaendige Adresse des Objekts",
        "required": true
      },
      {
        "name": "art_immobilie",
        "type": "string",
        "description": "Art der Immobilie (z.B. Mehrfamilienhaus, Einfamilienhaus)",
        "required": true
      },
      {
        "name": "putzart",
        "type": "string",
        "description": "Art des Putzes (z.B. Silikatputz, Mineralputz)",
        "required": false
      },
      {
        "name": "vorhandene_schaeden",
        "type": "string",
        "description": "Beschreibung vorhandener Schaeden",
        "required": false
      },
      {
        "name": "gemessene_werte",
        "type": "string",
        "description": "Gemessene Werte der Fassadenflächen",
        "required": false
      },
      {
        "name": "gesamtflaeche_qm",
        "type": "number",
        "description": "Gesamtflaeche in Quadratmetern",
        "required": false
      },
      {
        "name": "fotos",
        "type": "array",
        "description": "Liste von Foto-Pfaden oder URLs",
        "required": false,
        "default": []
      },
      {
        "name": "durchgefuehrt_durch",
        "type": "string",
        "description": "Name des Erfassenden",
        "required": true
      }
    ],
    "outputs": [
      {
        "name": "objektdaten_json",
        "type": "object",
        "description": "Strukturierte Objektdaten als JSON"
      },
      {
        "name": "pdf_path",
        "type": "string",
        "description": "Pfad zum generierten PDF-Dokument"
      },
      {
        "name": "success",
        "type": "boolean",
        "description": "Ob die Erfassung erfolgreich war"
      }
    ]
  },
  "dependencies": [
    "fassadenfix_branding"
  ],
  "orchestration": {
    "default_enabled": false,
    "priority": 50,
    "scope": "project",
    "auto_inject": false
  },
  "metadata": {
    "created_at": "2026-02-02T12:00:00Z",
    "updated_at": "2026-02-02T12:00:00Z",
    "license": "Proprietary - FassadenFix GmbH",
    "documentation": "SKILL.md",
    "original_template": "FF-OBJ-001_Objektdatenblatt.pdf"
  }
}
