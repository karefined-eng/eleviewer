{
  "manifest_version": "1.0",
  "type": "skill",
  "name": "ff_baustelle",
  "version": "1.0.0",
  "description": "Verwaltet Baustelleninformationen und -logistik für FassadenFix-Projekte. Erfasst Standortdaten, Zugangsinformationen, Sicherheitsanforderungen und koordiniert Ressourcen.",
  "author": "FassadenFix",
  "tags": [
    "baustelle",
    "projekt",
    "logistik",
    "standort",
    "sicherheit",
    "fassadenfix",
    "projektdurchführung"
  ],
  "capabilities": [
    "project_management",
    "logistics",
    "data_processing",
    "pdf_generation"
  ],
  "implementation": {
    "language": "python",
    "entrypoint": "main.py"
  },
  "interface": {
    "inputs": [
      {
        "name": "projekt_name",
        "type": "string",
        "description": "Name des Projekts/der Baustelle",
        "required": true
      },
      {
        "name": "adresse",
        "type": "object",
        "description": "Adressdaten der Baustelle (strasse, plz, ort)",
        "required": true
      },
      {
        "name": "bauherr",
        "type": "object",
        "description": "Kontaktdaten des Bauherrn (name, telefon, email)",
        "required": true
      },
      {
        "name": "bauleiter",
        "type": "string",
        "description": "Name des zuständigen Bauleiters",
        "required": true
      },
      {
        "name": "startdatum",
        "type": "string",
        "description": "Geplantes Startdatum (YYYY-MM-DD)",
        "required": true
      },
      {
        "name": "enddatum",
        "type": "string",
        "description": "Geplantes Enddatum (YYYY-MM-DD)",
        "required": false
      },
      {
        "name": "zugang",
        "type": "object",
        "description": "Zugangsinformationen (schluessel, code, ansprechpartner)",
        "required": false
      },
      {
        "name": "sicherheit",
        "type": "object",
        "description": "Sicherheitsanforderungen (geruest, absperrung, psa)",
        "required": false
      },
      {
        "name": "ressourcen",
        "type": "array",
        "description": "Liste der benötigten Ressourcen (Fahrzeuge, Geräte, Material)",
        "required": false
      },
      {
        "name": "notizen",
        "type": "string",
        "description": "Zusätzliche Notizen zur Baustelle",
        "required": false
      }
    ],
    "outputs": [
      {
        "name": "baustellen_id",
        "type": "string",
        "description": "Eindeutige Baustellen-ID"
      },
      {
        "name": "status",
        "type": "string",
        "description": "Aktueller Status der Baustelle"
      },
      {
        "name": "pdf_path",
        "type": "string",
        "description": "Pfad zum generierten Baustellendatenblatt"
      },
      {
        "name": "baustellen_daten",
        "type": "object",
        "description": "Vollständige Baustellendaten als Objekt"
      }
    ]
  },
  "dependencies": [],
  "metadata": {
    "created_at": "2026-02-02T00:00:00Z",
    "updated_at": "2026-02-02T00:00:00Z",
