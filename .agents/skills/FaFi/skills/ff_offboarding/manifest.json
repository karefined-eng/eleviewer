{
  "manifest_version": "1.0",
  "type": "skill",
  "name": "ff_offboarding",
  "version": "1.0.0",
  "description": "Unterstützt den Offboarding-Prozess für ausscheidende Mitarbeiter. Verwaltet Checklisten für Rückgabe von Firmeneigentum, Zugriffsrechte-Entzug, Wissenstransfer und Austrittsdokumentation.",
  "author": "FassadenFix",
  "tags": [
    "offboarding",
    "hr",
    "personal",
    "austritt",
    "checkliste",
    "fassadenfix",
    "interne-prozesse"
  ],
  "capabilities": [
    "hr_management",
    "checklist_management",
    "documentation",
    "pdf_generation"
  ],
  "implementation": {
    "language": "python",
    "entrypoint": "main.py"
  },
  "interface": {
    "inputs": [
      {
        "name": "mitarbeiter",
        "type": "object",
        "description": "Mitarbeiterdaten (name, personalnummer, abteilung, position, eintrittsdatum)",
        "required": true
      },
      {
        "name": "austrittsdatum",
        "type": "string",
        "description": "Letzter Arbeitstag (YYYY-MM-DD)",
        "required": true
      },
      {
        "name": "austrittsgrund",
        "type": "string",
        "description": "Grund für das Ausscheiden (kuendigung_mitarbeiter, kuendigung_arbeitgeber, aufhebung, befristung, rente)",
        "required": true
      },
      {
        "name": "rueckgabe",
        "type": "object",
        "description": "Rückgabe-Checkliste (schluessel, laptop, handy, arbeitskleidung, werkzeug, fahrzeug)",
        "required": false
      },
      {
        "name": "zugriffsrechte",
        "type": "object",
        "description": "Zu entziehende Zugriffsrechte (email, systeme, gebaeude, fahrzeuge)",
        "required": false
      },
      {
        "name": "wissenstransfer",
        "type": "object",
        "description": "Wissenstransfer-Dokumentation (nachfolger, uebergabe_themen, dokumentation)",
        "required": false
      },
      {
        "name": "zeugnis",
        "type": "object",
        "description": "Zeugnis-Anforderungen (typ, bewertung, schwerpunkte)",
        "required": false
      },
      {
        "name": "notizen",
        "type": "string",
        "description": "Zusätzliche Notizen zum Offboarding",
        "required": false
      }
    ],
    "outputs": [
      {
        "name": "offboarding_id",
        "type": "string",
        "description": "Eindeutige Offboarding-ID"
      },
      {
        "name": "status",
        "type": "string",
        "description": "Aktueller Offboarding-Status"
      },
      {
        "name": "checkliste",
        "type": "object",
        "description": "Offboarding-Checkliste mit Status"
      },
      {
        "name": "offene_punkte",
        "type": "array",
        "description": "Liste der noch offenen Punkte"
      },
      {
        "name": "pdf_path",
        "type": "string",
        "description": "Pfad zum generierten Offboarding-Protokoll"
      }
    ]
  },
  "dependencies": [],
  "metadata": {
    "created_at": "2026-02-02T00:00:00Z",
    "updated_at": "2026-02-02T00:00:00Z",
