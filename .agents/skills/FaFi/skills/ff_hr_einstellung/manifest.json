{
  "manifest_version": "1.0",
  "type": "skill",
  "name": "ff_hr_einstellung",
  "version": "1.0.0",
  "description": "Digitalisiert den Personalfragebogen und Einstellungsprozess. Verwenden fuer: Erfassung von Mitarbeiterdaten, Bankverbindung, Steuerklasse, Sozialversicherung, Dokumenten-Upload, PDF-Generierung.",
  "author": "FassadenFix",
  "tags": [
    "hr",
    "personal",
    "einstellung",
    "personalfragebogen",
    "mitarbeiter",
    "lohnbuchhaltung",
    "fassadenfix"
  ],
  "capabilities": [
    "hr_management",
    "form_processing",
    "pdf_generation",
    "data_validation"
  ],
  "implementation": {
    "language": "python",
    "entrypoint": "main.py"
  },
  "interface": {
    "inputs": [
      {"name": "familienname", "type": "string", "description": "Familienname des Mitarbeiters", "required": true},
      {"name": "vorname", "type": "string", "description": "Vorname des Mitarbeiters", "required": true},
      {"name": "geburtsdatum", "type": "string", "description": "Geburtsdatum (TT.MM.JJJJ)", "required": true},
      {"name": "iban", "type": "string", "description": "IBAN fuer Gehaltsueberweisungen", "required": true},
      {"name": "steuerklasse", "type": "string", "description": "Lohnsteuerklasse (I-VI)", "required": true},
      {"name": "krankenkasse", "type": "string", "description": "Name der Krankenkasse", "required": true},
      {"name": "eintrittsdatum", "type": "string", "description": "Geplantes Eintrittsdatum", "required": true}
    ],
    "outputs": [
      {"name": "personalfragebogen_json", "type": "object", "description": "Strukturierte Mitarbeiterdaten als JSON"},
      {"name": "pdf_path", "type": "string", "description": "Pfad zum generierten PDF-Fragebogen"},
      {"name": "validierung", "type": "object", "description": "Ergebnis der Datenvalidierung"},
      {"name": "success", "type": "boolean", "description": "Ob die Erfassung erfolgreich war"}
    ]
  },
  "dependencies": ["fassadenfix_branding"],
  "orchestration": {"default_enabled": false, "priority": 50, "scope": "hr"},
