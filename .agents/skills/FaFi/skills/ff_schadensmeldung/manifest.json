{
  "manifest_version": "1.0",
  "type": "skill",
  "name": "ff_schadensmeldung",
  "version": "1.0.0",
  "description": "Ermoeglicht schnelle und strukturierte digitale Schadensmeldungen. Verwenden fuer: Schadenserfassung mit vordefinierten Kategorien, Foto-Upload, Dringlichkeitsstufen, automatische Benachrichtigung.",
  "author": "FassadenFix",
  "tags": [
    "schadensmeldung",
    "reklamation",
    "garantie",
    "meldung",
    "pdf",
    "benachrichtigung",
    "fassadenfix"
  ],
  "capabilities": [
    "damage_reporting",
    "pdf_generation",
    "form_processing",
    "photo_upload",
    "notification"
  ],
  "implementation": {
    "language": "python",
    "entrypoint": "main.py"
  },
  "interface": {
    "inputs": [
      {
        "name": "projektnummer",
        "type": "string",
        "description": "Projektnummer (falls bekannt)",
        "required": false
      },
      {
        "name": "objektadresse",
        "type": "string",
        "description": "Adresse des betroffenen Objekts",
        "required": true
      },
      {
        "name": "schadensart",
        "type": "string",
        "description": "Art des Schadens",
        "required": true,
        "enum": ["Algen-/Pilzbefall (Neubefall)", "Putzschaeden", "Farbschaeden", "Risse", "Abplatzungen", "Sonstige Schaeden"]
      },
      {
        "name": "beschreibung",
        "type": "string",
        "description": "Detaillierte Beschreibung des Schadens",
        "required": true
      },
      {
        "name": "dringlichkeit",
        "type": "string",
        "description": "Dringlichkeitsstufe",
        "required": false,
        "default": "Mittel",
        "enum": ["Niedrig", "Mittel", "Hoch", "Kritisch"]
      },
      {
        "name": "fotos",
        "type": "array",
        "description": "Liste von Foto-Pfaden",
        "required": false
      },
      {
        "name": "melder_name",
        "type": "string",
        "description": "Name der meldenden Person",
        "required": true
      },
      {
        "name": "melder_kontakt",
        "type": "string",
        "description": "Kontaktdaten (Telefon oder E-Mail)",
        "required": true
      }
    ],
    "outputs": [
      {
        "name": "meldung_json",
        "type": "object",
        "description": "Strukturierte Meldungsdaten als JSON"
      },
      {
        "name": "pdf_path",
        "type": "string",
        "description": "Pfad zum generierten Meldungsprotokoll"
      },
      {
        "name": "meldungsnummer",
        "type": "string",
        "description": "Eindeutige Meldungsnummer"
      },
      {
        "name": "success",
        "type": "boolean",
        "description": "Ob die Meldung erfolgreich erfasst wurde"
      }
    ]
  },
  "dependencies": [
    "fassadenfix_branding"
  ],
  "orchestration": {
    "default_enabled": false,
    "priority": 60,
    "scope": "project"
  },
  "metadata": {
    "created_at": "2026-02-02T12:00:00Z",
    "updated_at": "2026-02-02T12:00:00Z",
    "license": "Proprietary - FassadenFix GmbH",
    "documentation": "SKILL.md"
  }
}
