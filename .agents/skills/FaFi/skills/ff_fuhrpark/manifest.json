{
  "manifest_version": "1.0",
  "type": "skill",
  "name": "ff_fuhrpark",
  "version": "1.0.0",
  "description": "Verwaltet den FassadenFix Fuhrpark und die Fahrzeugzuordnung. Erfasst Fahrzeugdaten, Wartungstermine, Tankbelege und koordiniert Fahrzeugbuchungen für Baustellen.",
  "author": "FassadenFix",
  "tags": [
    "fuhrpark",
    "fahrzeug",
    "logistik",
    "wartung",
    "buchung",
    "fassadenfix",
    "interne-prozesse"
  ],
  "capabilities": [
    "fleet_management",
    "booking",
    "maintenance_tracking",
    "pdf_generation"
  ],
  "implementation": {
    "language": "python",
    "entrypoint": "main.py"
  },
  "interface": {
    "inputs": [
      {
        "name": "aktion",
        "type": "string",
        "description": "Auszuführende Aktion (fahrzeug_anlegen, fahrzeug_buchen, wartung_eintragen, tankbeleg_erfassen, status_abfragen)",
        "required": true
      },
      {
        "name": "fahrzeug_id",
        "type": "string",
        "description": "Eindeutige Fahrzeug-ID (für bestehende Fahrzeuge)",
        "required": false
      },
      {
        "name": "fahrzeug_daten",
        "type": "object",
        "description": "Fahrzeugdaten (kennzeichen, typ, marke, modell, baujahr, km_stand)",
        "required": false
      },
      {
        "name": "buchung",
        "type": "object",
        "description": "Buchungsdaten (baustelle_id, fahrer, datum_von, datum_bis)",
        "required": false
      },
      {
        "name": "wartung",
        "type": "object",
        "description": "Wartungsdaten (typ, datum, km_stand, kosten, werkstatt, notizen)",
        "required": false
      },
      {
        "name": "tankbeleg",
        "type": "object",
        "description": "Tankbelegdaten (datum, liter, kosten, km_stand, tankstelle)",
        "required": false
      }
    ],
    "outputs": [
      {
        "name": "fahrzeug_id",
        "type": "string",
        "description": "Fahrzeug-ID"
      },
      {
        "name": "status",
        "type": "string",
        "description": "Aktueller Fahrzeugstatus"
      },
      {
        "name": "buchungen",
        "type": "array",
        "description": "Liste der aktiven Buchungen"
      },
      {
        "name": "naechste_wartung",
        "type": "object",
        "description": "Nächster Wartungstermin"
      },
      {
        "name": "pdf_path",
        "type": "string",
        "description": "Pfad zum generierten Fahrzeugbericht"
      }
    ]
  },
  "dependencies": [],
  "metadata": {
    "created_at": "2026-02-02T00:00:00Z",
    "updated_at": "2026-02-02T00:00:00Z",
