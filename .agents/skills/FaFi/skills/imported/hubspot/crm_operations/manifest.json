{
  "manifest_version": "1.0",
  "type": "skill",
  "name": "hubspot_crm_operations",
  "version": "1.0.0",
  "description": "Führt CRM-Operationen in HubSpot durch (Kontakte, Unternehmen, Deals). Nutzt den HubSpot MCP-Server.",
  "author": "Skill Hub (Imported)",
  "tags": ["hubspot", "crm", "contact", "company", "deal", "imported", "mcp"],
  "capabilities": ["crm", "contact_management", "company_management", "deal_management"],
  "implementation": {
    "type": "remote",
    "language": "mcp",
    "entrypoint": "main.py",
    "remote_config": {
      "server": "hubspot",
      "tools": ["create_contact", "search_contacts", "create_company", "create_deal"]
    }
  },
  "interface": {
    "inputs": [
      {
        "name": "operation",
        "type": "string",
        "description": "CRM-Operation (create_contact, search_contacts, create_company, create_deal, update_contact)",
        "required": true,
        "enum": ["create_contact", "search_contacts", "create_company", "create_deal", "update_contact"]
      },
      {
        "name": "data",
        "type": "object",
        "description": "Daten für die Operation (abhängig von der gewählten Operation)",
        "required": true
      }
    ],
    "outputs": [
      {
        "name": "result",
        "type": "object",
        "description": "Ergebnis der CRM-Operation"
      },
      {
        "name": "status",
        "type": "string",
        "description": "Ausführungsstatus"
      }
    ]
  },
  "metadata": {
    "source_platform": "HubSpot",
    "imported": true,
    "mcp_server": "hubspot",
    "created_at": "2026-01-23T12:00:00Z"
  }
}
