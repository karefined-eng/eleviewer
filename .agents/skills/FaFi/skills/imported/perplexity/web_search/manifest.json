{
  "manifest_version": "1.0",
  "type": "skill",
  "name": "perplexity_web_search",
  "version": "1.0.0",
  "description": "Führt eine Echtzeit-Websuche mit Perplexity AI durch und gibt Ergebnisse mit Quellenangaben zurück.",
  "author": "Skill Hub (Imported)",
  "tags": ["perplexity", "search", "web", "realtime", "sources", "imported"],
  "capabilities": ["web_search", "realtime_information", "citation"],
  "implementation": {
    "type": "remote",
    "language": "python",
    "entrypoint": "main.py",
    "remote_config": {
      "service": "perplexity_api",
      "model": "sonar",
      "endpoint": "/chat/completions"
    }
  },
  "interface": {
    "inputs": [
      {
        "name": "query",
        "type": "string",
        "description": "Suchanfrage",
        "required": true
      },
      {
        "name": "focus",
        "type": "string",
        "description": "Suchfokus (web, academic, news, youtube, reddit)",
        "required": false,
        "default": "web",
        "enum": ["web", "academic", "news", "youtube", "reddit"]
      }
    ],
    "outputs": [
      {
        "name": "answer",
        "type": "string",
        "description": "Zusammengefasste Antwort"
      },
      {
        "name": "citations",
        "type": "array",
        "description": "Liste der Quellen mit URLs"
      }
    ]
  },
  "metadata": {
    "source_platform": "Perplexity",
    "imported": true,
    "created_at": "2026-01-23T12:00:00Z",
    "license": "API Terms of Service"
  }
}
