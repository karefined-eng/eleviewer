{
  "name": "claude_code_analyze",
  "version": "1.0.0",
  "type": "skill",
  "description": "Analysiert Code mit Claude Code und identifiziert Probleme, Verbesserungen und Best Practices.",
  "author": "Skill-Agent-Hub",
  "tags": ["claude", "code", "analysis", "review", "imported"],
  "capabilities": ["code_analysis", "code_review", "bug_detection"],
  "implementation": {
    "type": "remote",
    "language": "claude_code_cli",
    "entrypoint": "main.py"
  },
  "interface": {
    "inputs": [
      {
        "name": "code",
        "type": "string",
        "description": "Code zur Analyse",
        "required": true
      },
      {
        "name": "language",
        "type": "string",
        "description": "Programmiersprache (python, javascript, typescript, etc.)",
        "required": false
      },
      {
        "name": "focus",
        "type": "string",
        "description": "Analysefokus: bugs, security, performance, style, all",
        "required": false,
        "default": "all"
      }
    ],
    "outputs": [
      {
        "name": "analysis",
        "type": "string",
        "description": "Detaillierte Analyse des Codes"
      },
      {
        "name": "issues",
        "type": "array",
        "description": "Liste der gefundenen Probleme"
      },
      {
        "name": "suggestions",
        "type": "array",
        "description": "Verbesserungsvorschläge"
      }
    ]
  },
  "dependencies": [],
  "metadata": {
    "source_platform": "claude_code",
    "bidirectional": true,
    "import_date": "2026-01-23"
  }
}
