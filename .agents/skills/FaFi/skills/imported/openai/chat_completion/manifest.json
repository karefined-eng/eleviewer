{
  "name": "openai_chat_completion",
  "version": "1.0.0",
  "type": "skill",
  "description": "Führt eine Chat-Completion mit GPT-Modellen durch und gibt die Antwort zurück.",
  "author": "Skill-Agent-Hub",
  "tags": ["openai", "gpt", "chat", "llm", "imported"],
  "capabilities": ["chat", "text_generation", "reasoning"],
  "implementation": {
    "type": "remote",
    "language": "openai_api",
    "entrypoint": "main.py"
  },
  "interface": {
    "inputs": [
      {
        "name": "messages",
        "type": "array",
        "description": "Chat-Nachrichten im Format [{role: 'user'|'assistant'|'system', content: 'text'}]",
        "required": true
      },
      {
        "name": "model",
        "type": "string",
        "description": "GPT-Modell (gpt-4o, gpt-4-turbo, gpt-3.5-turbo)",
        "required": false,
        "default": "gpt-4o"
      },
      {
        "name": "temperature",
        "type": "number",
        "description": "Temperatur für die Generierung (0-2)",
        "required": false,
        "default": 0.7
      },
      {
        "name": "max_tokens",
        "type": "number",
        "description": "Maximale Token-Anzahl für die Antwort",
        "required": false
      }
    ],
    "outputs": [
      {
        "name": "response",
        "type": "string",
        "description": "GPT-Antwort"
      },
      {
        "name": "usage",
        "type": "object",
        "description": "Token-Nutzung (prompt_tokens, completion_tokens, total_tokens)"
      },
      {
        "name": "finish_reason",
        "type": "string",
        "description": "Grund für das Beenden"
      }
    ]
  },
  "dependencies": [],
  "metadata": {
    "source_platform": "openai",
    "bidirectional": true,
    "import_date": "2026-01-23"
  }
}
