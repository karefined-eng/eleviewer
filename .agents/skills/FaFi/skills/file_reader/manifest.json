{
  "manifest_version": "1.0",
  "type": "skill",
  "name": "file_reader",
  "version": "1.0.0",
  "description": "Liest verschiedene Dateiformate und extrahiert deren Inhalt als Text.",
  "author": "Skill Hub",
  "tags": ["file", "io", "text", "document"],
  "capabilities": ["file_reading", "text_extraction", "document_processing"],
  "implementation": {
    "language": "python",
    "entrypoint": "main.py",
    "dependencies": "requirements.txt"
  },
  "interface": {
    "inputs": [
      {
        "name": "file_path",
        "type": "string",
        "description": "Pfad zur zu lesenden Datei",
        "required": true
      },
      {
        "name": "encoding",
        "type": "string",
        "description": "Zeichenkodierung für Textdateien",
        "required": false,
        "default": "utf-8"
      }
    ],
    "outputs": [
      {
        "name": "content",
        "type": "string",
        "description": "Extrahierter Textinhalt"
      },
      {
        "name": "file_type",
        "type": "string",
        "description": "Erkannter Dateityp"
      },
      {
        "name": "metadata",
        "type": "object",
        "description": "Datei-Metadaten (Größe, Änderungsdatum, etc.)"
      }
    ]
  },
  "metadata": {
    "created_at": "2026-01-23T10:00:00Z",
    "license": "MIT"
  }
}
