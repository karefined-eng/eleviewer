{
  "manifest_version": "1.0",
  "type": "skill",
  "name": "data_analyzer",
  "version": "1.0.0",
  "description": "Analysiert strukturierte Daten und erstellt statistische Zusammenfassungen.",
  "author": "Skill Hub",
  "tags": ["data", "analysis", "statistics", "csv"],
  "capabilities": ["data_analysis", "statistics", "aggregation"],
  "implementation": {
    "language": "python",
    "entrypoint": "main.py",
    "dependencies": "requirements.txt"
  },
  "interface": {
    "inputs": [
      {
        "name": "data",
        "type": "object",
        "description": "Die zu analysierenden Daten (Liste von Dictionaries oder Pfad zu CSV)",
        "required": true
      },
      {
        "name": "analysis_type",
        "type": "string",
        "description": "Art der Analyse",
        "required": false,
        "default": "summary",
        "enum": ["summary", "correlation", "distribution", "trends"]
      },
      {
        "name": "columns",
        "type": "array",
        "description": "Spezifische Spalten für die Analyse",
        "required": false
      }
    ],
    "outputs": [
      {
        "name": "analysis",
        "type": "object",
        "description": "Analyseergebnisse"
      },
      {
        "name": "insights",
        "type": "array",
        "description": "Automatisch generierte Erkenntnisse"
      },
      {
        "name": "statistics",
        "type": "object",
        "description": "Statistische Kennzahlen"
      }
    ]
  },
  "metadata": {
    "created_at": "2026-01-23T10:00:00Z",
    "license": "MIT"
  }
}
