{
  "manifest_version": "1.0",
  "type": "skill",
  "name": "ff_zeitnachweis",
  "version": "1.0.0",
  "description": "Digitaler Stundenzettel fuer Mitarbeiter. Verwenden fuer: Tageserfassung von Arbeitszeiten, Projektzuordnung, Pausen, Ueberstunden-Berechnung, monatliche Zusammenfassung.",
  "author": "FassadenFix",
  "tags": [
    "hr",
    "zeiterfassung",
    "stundenzettel",
    "arbeitszeit",
    "ueberstunden",
    "projekt",
    "fassadenfix"
  ],
  "capabilities": [
    "time_tracking",
    "calculation",
    "pdf_generation",
    "project_assignment"
  ],
  "implementation": {
    "language": "python",
    "entrypoint": "main.py"
  },
  "interface": {
    "inputs": [
      {"name": "mitarbeiter_name", "type": "string", "description": "Name des Mitarbeiters", "required": true},
      {"name": "monat", "type": "integer", "description": "Monat (1-12)", "required": true},
      {"name": "jahr", "type": "integer", "description": "Jahr", "required": true},
      {"name": "eintraege", "type": "array", "description": "Liste der Tageseintraege", "required": false}
    ],
    "outputs": [
      {"name": "zeitnachweis_json", "type": "object", "description": "Strukturierte Zeitdaten als JSON"},
      {"name": "pdf_path", "type": "string", "description": "Pfad zum generierten Stundenzettel"},
      {"name": "soll_stunden", "type": "number", "description": "Soll-Arbeitszeit des Monats"},
      {"name": "ist_stunden", "type": "number", "description": "Tatsaechliche Arbeitszeit"},
      {"name": "ueberstunden", "type": "number", "description": "Ueberstunden-Saldo"},
      {"name": "success", "type": "boolean", "description": "Ob der Nachweis erstellt wurde"}
    ]
  },
  "dependencies": ["fassadenfix_branding"],
  "orchestration": {"default_enabled": false, "priority": 40, "scope": "hr"},
  "metadata": {
    "created_at": "2026-02-02T12:00:00Z",
    "updated_at": "2026-02-02T12:00:00Z",
