{
  "manifest_version": "1.0",
  "type": "skill",
  "name": "web_scraper",
  "version": "1.0.0",
  "description": "Extrahiert Inhalte von Webseiten. Unterstützt Text, Links und strukturierte Daten.",
  "author": "Skill Hub",
  "tags": ["web", "scraping", "extraction", "data"],
  "capabilities": ["web_scraping", "content_extraction", "data_collection"],
  "implementation": {
    "language": "python",
    "entrypoint": "main.py",
    "dependencies": "requirements.txt"
  },
  "interface": {
    "inputs": [
      {
        "name": "url",
        "type": "string",
        "description": "Die URL der zu scrapenden Webseite",
        "required": true
      },
      {
        "name": "extract_type",
        "type": "string",
        "description": "Art der zu extrahierenden Daten",
        "required": false,
        "default": "text",
        "enum": ["text", "links", "images", "all"]
      },
      {
        "name": "selector",
        "type": "string",
        "description": "Optionaler CSS-Selektor für spezifische Elemente",
        "required": false
      }
    ],
    "outputs": [
      {
        "name": "content",
        "type": "string",
        "description": "Extrahierter Textinhalt"
      },
      {
        "name": "links",
        "type": "array",
        "description": "Liste der gefundenen Links"
      },
      {
        "name": "images",
        "type": "array",
        "description": "Liste der gefundenen Bild-URLs"
      },
      {
        "name": "title",
        "type": "string",
        "description": "Seitentitel"
      }
    ]
  },
  "metadata": {
    "created_at": "2026-01-23T10:00:00Z",
    "license": "MIT"
  }
}
