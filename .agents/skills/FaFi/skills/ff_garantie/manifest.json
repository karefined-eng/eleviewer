{
  "manifest_version": "1.0",
  "type": "skill",
  "name": "ff_garantie",
  "version": "1.0.0",
  "description": "Erstellt professionelle Garantieurkunden nach Projektabnahme. Verwenden fuer: Kundendaten-Erfassung, automatische Garantiezeitraum-Berechnung (5 Jahre), PDF-Generierung mit offiziellem Design.",
  "author": "FassadenFix",
  "tags": [
    "garantie",
    "urkunde",
    "zertifikat",
    "pdf",
    "abnahme",
    "qualitaet",
    "fassadenfix"
  ],
  "capabilities": [
    "certificate_generation",
    "pdf_generation",
    "date_calculation"
  ],
  "implementation": {
    "language": "python",
    "entrypoint": "main.py"
  },
  "interface": {
    "inputs": [
      {
        "name": "kundenname",
        "type": "string",
        "description": "Name oder Firma des Kunden",
        "required": true
      },
      {
        "name": "kundenadresse",
        "type": "string",
        "description": "Adresse des Kunden",
        "required": false
      },
      {
        "name": "projektnummer",
        "type": "string",
        "description": "Eindeutige Projektnummer",
        "required": false
      },
      {
        "name": "abnahmedatum",
        "type": "string",
        "description": "Datum der Projektabnahme (YYYY-MM-DD)",
        "required": true
      }
    ],
    "outputs": [
      {
        "name": "garantie_json",
        "type": "object",
        "description": "Strukturierte Garantiedaten als JSON"
      },
      {
        "name": "pdf_path",
        "type": "string",
        "description": "Pfad zur generierten Garantieurkunde"
      },
      {
        "name": "garantie_bis",
        "type": "string",
        "description": "Berechnetes Garantieende (5 Jahre)"
      },
      {
        "name": "success",
        "type": "boolean",
        "description": "Ob die Garantieurkunde erfolgreich erstellt wurde"
      }
    ]
  },
  "dependencies": [
    "fassadenfix_branding"
  ],
  "orchestration": {
    "default_enabled": false,
    "priority": 40,
    "scope": "project"
  },
