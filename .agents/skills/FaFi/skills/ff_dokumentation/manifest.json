{
  "manifest_version": "1.0",
  "type": "skill",
  "name": "ff_dokumentation",
  "version": "1.0.0",
  "description": "Erstellt Vorher-Nachher-Dokumentationen und Abnahmeprotokolle. Verwenden fuer: Checklisten-basierte Zustandserfassung, Wasseruhren-Dokumentation, Foto-Upload, digitale Unterschriften und PDF-Generierung.",
  "author": "FassadenFix",
  "tags": [
    "dokumentation",
    "abnahme",
    "vorher-nachher",
    "protokoll",
    "pdf",
    "checkliste",
    "fassadenfix"
  ],
  "capabilities": [
    "documentation",
    "pdf_generation",
    "form_processing",
    "photo_upload",
    "digital_signature"
  ],
  "implementation": {
    "language": "python",
    "entrypoint": "main.py"
  },
  "interface": {
    "inputs": [
      {
        "name": "typ",
        "type": "string",
        "description": "Dokumentationstyp: vorher oder nachher",
        "required": true,
        "enum": ["vorher", "nachher"]
      },
      {
        "name": "projektnummer",
        "type": "string",
        "description": "Eindeutige Projektnummer",
        "required": true
      },
      {
        "name": "anschrift",
        "type": "string",
        "description": "Vollstaendige Adresse des Objekts",
        "required": true
      },
      {
        "name": "fotodokumentation",
        "type": "boolean",
        "description": "Wurden Fotos gemacht?",
        "required": false
      },
      {
        "name": "vorhandene_schaeden",
        "type": "boolean",
        "description": "Sind Schaeden vorhanden?",
        "required": false
      },
      {
        "name": "wasseruhren",
        "type": "array",
        "description": "Liste der Wasseruhren-Zaehlerstaende",
        "required": false
      }
    ],
    "outputs": [
      {
        "name": "dokumentation_json",
        "type": "object",
        "description": "Strukturierte Dokumentationsdaten als JSON"
      },
      {
        "name": "pdf_path",
        "type": "string",
        "description": "Pfad zum generierten PDF-Protokoll"
      },
      {
        "name": "success",
        "type": "boolean",
        "description": "Ob die Dokumentation erfolgreich erstellt wurde"
      }
    ]
  },
  "dependencies": [
    "fassadenfix_branding"
  ],
  "orchestration": {
    "default_enabled": false,
    "priority": 50,
    "scope": "project"
  },
  "metadata": {
    "created_at": "2026-02-02T12:00:00Z",
    "updated_at": "2026-02-02T12:00:00Z",
    "license": "Proprietary - FassadenFix GmbH",
    "documentation": "SKILL.md",
    "original_templates": ["FF-ABN-001_Dokumentation_vorher.pdf", "FF-ABN-002_Dokumentation_nachher.pdf"]
  }
}
