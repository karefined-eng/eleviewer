{
  "agent_config": {
    "capabilities": [
      "web_search",
      "code_execution",
      "file_operations",
      "data_analysis"
    ],
    "description": "Agent mit Zugriff auf den Skill & Agent Hub",
    "name": "SkillHubAgent",
    "settings": {
      "max_iterations": 20,
      "timeout_seconds": 300,
      "verbose": true
    },
    "tools": {
      "skill_hub": {
        "base_url": "https://skill-hub.example.com/api/v1",
        "endpoints": {
          "discover": "/discover",
          "execute_agent": "/execute/agent/{name}",
          "execute_skill": "/execute/skill/{name}"
        },
        "type": "external_api"
      }
    }
  }
}
