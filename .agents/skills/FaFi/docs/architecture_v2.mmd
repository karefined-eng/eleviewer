graph TD
    subgraph "Externe KI-Plattformen"
        direction TB
        subgraph "Microsoft"
            M365[Microsoft 365 Copilot]
        end
        subgraph "Google"
            GEM[Gemini]
            NLM[NotebookLM]
            GAIS[AI Studio]
        end
        subgraph "Andere KI"
            PPL[Perplexity]
            ABA[Abacus AI]
            CLA[Claude]
            GPT[ChatGPT Codex]
        end
        subgraph "Business"
            HUB[HubSpot]
            BRZ[HubSpot Breeze]
        end
    end

    subgraph "Skill & Agent Hub"
        direction TB
        subgraph "API Layer"
            API[REST API Server<br/>Port 5000]
        end
        
        subgraph "Adapter Layer"
            BA[Bidirektionale Adapter]
            EA[Export Adapter]
        end
        
        subgraph "Core Services"
            ORCH[Orchestrator Engine]
            DISC[Discovery Service]
            REG[Registry Service]
        end
        
        subgraph "Skill Library"
            NS[Native Skills<br/>text_summarizer<br/>web_scraper<br/>data_analyzer]
            IS[Imported Skills<br/>perplexity_search<br/>hubspot_crm<br/>gemini_multimodal<br/>m365_graph_api]
        end
        
        subgraph "Agent Library"
            AG[Agents<br/>research_agent<br/>content_creator]
        end
    end

    %% Bidirektionale Verbindungen
    M365 <-->|"Export & Import"| BA
    GEM <-->|"Export & Import"| BA
    NLM <-->|"Export & Import"| BA
    GAIS <-->|"Export & Import"| BA
    PPL <-->|"Export & Import"| BA
    ABA <-->|"Export & Import"| BA
    HUB <-->|"Export & Import"| BA
    BRZ <-->|"Export & Import"| BA
    
    %% Nur Export
    CLA -->|"Export Only"| EA
    GPT -->|"Export Only"| EA
    
    %% Interne Verbindungen
    BA --> API
    EA --> API
    API --> ORCH
    API --> DISC
    ORCH --> REG
    DISC --> REG
    REG --> NS
    REG --> IS
    REG --> AG
    
    %% Orchestrator zu Skills
    ORCH -.->|"Führt aus"| NS
    ORCH -.->|"Ruft remote auf"| IS
    AG -.->|"Kombiniert"| NS
    AG -.->|"Kombiniert"| IS
