{
  "manifest_version": "1.0",
  "type": "agent",
  "name": "research_agent",
  "version": "1.0.0",
  "description": "Führt umfassende Recherchen zu einem Thema durch. Kombiniert Web-Scraping, Textanalyse und Zusammenfassung.",
  "author": "Skill Hub",
  "tags": ["research", "web", "analysis", "summary"],
  "capabilities": ["research", "information_gathering", "synthesis"],
  "implementation": {
    "language": "python",
    "entrypoint": "main.py"
  },
  "interface": {
    "inputs": [
      {
        "name": "topic",
        "type": "string",
        "description": "Das zu recherchierende Thema",
        "required": true
      },
      {
        "name": "depth",
        "type": "string",
        "description": "Tiefe der Recherche",
        "required": false,
        "default": "standard",
        "enum": ["quick", "standard", "deep"]
      },
      {
        "name": "sources",
        "type": "array",
        "description": "Optionale Liste von URLs als Quellen",
        "required": false
      }
    ],
    "outputs": [
      {
        "name": "report",
        "type": "string",
        "description": "Zusammengefasster Recherchebericht"
      },
      {
        "name": "sources_used",
        "type": "array",
        "description": "Liste der verwendeten Quellen"
      },
      {
        "name": "key_findings",
        "type": "array",
        "description": "Wichtigste Erkenntnisse"
      }
    ]
  },
  "dependencies": [
    {"name": "web_scraper", "version": "1.0.0"},
    {"name": "text_summarizer", "version": "1.0.0"}
  ],
  "orchestration": {
    "strategy": "sequential",
    "steps": [
      {
        "skill": "web_scraper",
        "input_mapping": {
          "url": "$source_url",
          "extract_type": "text"
        },
        "output_mapping": {
          "content": "$scraped_content"
        }
      },
      {
        "skill": "text_summarizer",
        "input_mapping": {
          "text": "$scraped_content",
          "max_length": "300",
          "style": "formal"
        },
        "output_mapping": {
          "summary": "$source_summary"
        }
      }
    ]
  },
  "metadata": {
    "created_at": "2026-01-23T10:00:00Z",
    "license": "MIT"
  }
}
