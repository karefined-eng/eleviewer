{
  "manifest_version": "1.0",
  "type": "agent",
  "name": "content_creator",
  "version": "1.0.0",
  "description": "Erstellt strukturierte Inhalte basierend auf Quelldaten. Kombiniert Datenanalyse, Recherche und Texterstellung.",
  "author": "Skill Hub",
  "tags": ["content", "writing", "creation", "automation"],
  "capabilities": ["content_creation", "text_generation", "data_synthesis"],
  "implementation": {
    "language": "python",
    "entrypoint": "main.py"
  },
  "interface": {
    "inputs": [
      {
        "name": "content_type",
        "type": "string",
        "description": "Art des zu erstellenden Inhalts",
        "required": true,
        "enum": ["article", "report", "summary", "presentation_outline"]
      },
      {
        "name": "topic",
        "type": "string",
        "description": "Thema oder Titel des Inhalts",
        "required": true
      },
      {
        "name": "source_data",
        "type": "object",
        "description": "Quelldaten für den Inhalt (Text, Daten, URLs)",
        "required": false
      },
      {
        "name": "style",
        "type": "string",
        "description": "Schreibstil",
        "required": false,
        "default": "professional",
        "enum": ["professional", "casual", "academic", "marketing"]
      },
      {
        "name": "length",
        "type": "string",
        "description": "Gewünschte Länge",
        "required": false,
        "default": "medium",
        "enum": ["short", "medium", "long"]
      }
    ],
    "outputs": [
      {
        "name": "content",
        "type": "string",
        "description": "Der erstellte Inhalt"
      },
      {
        "name": "metadata",
        "type": "object",
        "description": "Metadaten zum erstellten Inhalt"
      },
      {
        "name": "suggestions",
        "type": "array",
        "description": "Vorschläge für Verbesserungen oder Erweiterungen"
      }
    ]
  },
  "dependencies": [
    {"name": "text_summarizer", "version": "1.0.0"},
    {"name": "data_analyzer", "version": "1.0.0"}
  ],
  "orchestration": {
    "strategy": "dynamic",
    "goal_description": "Erstelle strukturierten Inhalt basierend auf den bereitgestellten Quelldaten und dem gewünschten Format."
  },
  "metadata": {
    "created_at": "2026-01-23T10:00:00Z",
    "license": "MIT"
  }
}
