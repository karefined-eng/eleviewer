diff --git a/webview_worker.py b/webview_worker.py
new file mode 100644
index 0000000..5feebb1
--- /dev/null
+++ b/webview_worker.py
@@ -0,0 +1,25 @@
+import sys
+
+try:
+    import webview
+except ImportError:
+    print("WEBVIEW_MISSING: pywebview not installed. Run: pip install pywebview", flush=True)
+    sys.exit(2)
+
+def main():
+    if len(sys.argv) < 4:
+        print("Usage: python main.py --webview-worker <title> <url>")
+        sys.exit(1)
+        
+    title = sys.argv[2]
+    url = sys.argv[3]
+    
+    # We use frameless=True so it doesn't draw a Windows title bar
+    # This makes embedding it via SetParent look seamless.
+    window = webview.create_window(title, url, frameless=True)
+    
+    # Use gui='edgechromium' if explicitly specified, but default behavior on Win is WebView2
+    webview.start(gui='edgechromium')
+
+if __name__ == '__main__':
+    main()
