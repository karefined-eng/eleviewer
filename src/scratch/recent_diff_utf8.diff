diff --git a/screenshot.py b/screenshot.py
new file mode 100644
index 0000000..6a3cc66
--- /dev/null
+++ b/screenshot.py
@@ -0,0 +1,29 @@
+import sys
+import os
+from PySide6.QtWidgets import QApplication
+from PySide6.QtCore import QTimer
+
+# Disable onboarding and what's new dialog
+import settings
+s = settings.load_settings()
+s['onboarding_completed'] = True
+s['last_run_version'] = "1.3.1"  # ensure no whats new popup
+settings.save_settings(s)
+
+import ui
+
+app = QApplication.instance() or QApplication(sys.argv)
+
+win = ui.MainWindow()
+win.resize(1200, 800)
+win.show()
+
+def take_shot():
+    pixmap = win.grab()
+    out_name = sys.argv[1] if len(sys.argv) > 1 else "screenshot.png"
+    pixmap.save(out_name)
+    print(f"Saved {out_name}")
+    app.quit()
+
+QTimer.singleShot(1500, take_shot)
+sys.exit(app.exec())
