+        layout.addWidget(self._btn_open)
+        layout.addWidget(self._btn_folder)
+        layout.addWidget(self._btn_dismiss)
+
+        download.receivedBytesChanged.connect(self._update_progress)
+        download.totalBytesChanged.connect(self._update_progress)
+        download.stateChanged.connect(self._on_state_changed)
+        self._update_progress()
+        self._on_state_changed(download.state())
+
+    def _update_progress(self):
+        received = self._download.receivedBytes()
+        total = self._download.totalBytes()
+        if total > 0:
+            pct = int(received * 100 / total)
+            self._progress.setValue(pct)
+            self._status_label.setText(f"{self._fmt_size(received)} / {self._fmt_size(total)}")
+        else:
+            self._progress.setValue(0)
+            self._status_label.setText(f"{self._fmt_size(received)}")
+
+    @staticmethod
+    def _fmt_size(n: int) -> str:
+        if n < 1024:
+            return f"{n} B"
+        if n < 1024 * 1024:
+            return f"{n / 1024:.1f} KB"
+        return f"{n / (1024 * 1024):.1f} MB"
+
+    def _on_state_changed(self, state):
+        p = get_active_palette()
+        if state == QWebEngineDownloadRequest.DownloadState.DownloadInProgress:
+            self._status_label.setText("DownloadingΓÇª")
+        elif state == QWebEngineDownloadRequest.DownloadState.DownloadCompleted:
+            self._saved_path = self._download.path()
+            self._progress.setValue(100)
+            self._status_label.setText("Complete")
+            self._status_label.setStyleSheet(f"color: {get_brand_accent()}; font-size: 11px;")
+            self._btn_open.setVisible(True)
+            self._btn_folder.setVisible(True)
+        elif state == QWebEngineDownloadRequest.DownloadState.DownloadCancelled:
+            self._status_label.setText("Cancelled")
+            self._status_label.setStyleSheet(f"color: {p['BRAND_MUTED_FG']}; font-size: 11px;")
+        elif state == QWebEngineDownloadRequest.DownloadState.DownloadInterrupted:
+            self._status_label.setText("Failed")
+            self._status_label.setStyleSheet("color: #e05555; font-size: 11px;")
+
+    def _open_file(self):
+        path = self._saved_path or self._download.path()
+        if path and os.path.isfile(path):
+            QDesktopServices.openUrl(QUrl.fromLocalFile(path))
+
+    def _open_folder(self):
+        path = self._saved_path or self._download.path()
+        if path and os.path.isfile(path):
+            if os.name == "nt":
+                subprocess.Popen(["explorer", "/select,", os.path.normpath(path)])
+            else:
+                QDesktopServices.openUrl(QUrl.fromLocalFile(os.path.dirname(path)))
+
+    def _dismiss(self):
+        tray = self.parent()
+        while tray and not isinstance(tray, DownloadTray):
+            tray = tray.parent()
+        if isinstance(tray, DownloadTray):
+            tray.remove_row(self)
+        self.deleteLater()
+
+
+class DownloadTray(QWidget):
+    """Collapsible panel listing active and recent downloads."""
+
+    def __init__(self, parent=None):
+        super().__init__(parent)
+        p = get_active_palette()
+        self.setVisible(False)
+
+        outer = QVBoxLayout(self)
+        outer.setContentsMargins(0, 0, 0, 0)
+        outer.setSpacing(0)
+
+        header = QWidget()
+        header.setStyleSheet(
+            f"background: {p['BRAND_PANEL_2']}; border-top: 1px solid {p['BRAND_BORDER']};"
+        )
+        header_layout = QHBoxLayout(header)
+        header_layout.setContentsMargins(10, 4, 10, 4)
+
+        self._title = QLabel("Downloads")
+        self._title.setStyleSheet(f"color: {p['BRAND_PRIMARY']}; font-size: 12px; font-weight: bold;")
+
+        btn_style = f"""
+            QPushButton {{
+                background: transparent; color: {p['BRAND_MUTED_FG']};
+                border: none; font-size: 14px; padding: 2px 6px;
+            }}
+            QPushButton:hover {{ color: {p['BRAND_PRIMARY']}; }}
+        """
+        self._btn_collapse = QPushButton("Γû╝")
+        self._btn_collapse.setStyleSheet(btn_style)
+        self._btn_collapse.setToolTip("Hide downloads")
+        self._btn_collapse.clicked.connect(lambda: self.setVisible(False))
+
+        header_layout.addWidget(self._title)
+        header_layout.addStretch()
+        header_layout.addWidget(self._btn_collapse)
+        outer.addWidget(header)
+
+        scroll = QScrollArea()
+        scroll.setWidgetResizable(True)
+        scroll.setMaximumHeight(120)
+        scroll.setStyleSheet(f"QScrollArea {{ border: none; background: {p['BRAND_PANEL']}; }}")
+
+        self._list_widget = QWidget()
+        self._list_layout = QVBoxLayout(self._list_widget)
+        self._list_layout.setContentsMargins(6, 4, 6, 4)
+        self._list_layout.setSpacing(4)
+        self._list_layout.addStretch()
+        scroll.setWidget(self._list_widget)
+        outer.addWidget(scroll)
+
+        self._rows: list[_DownloadRow] = []
+
+    def handle_download(self, download: QWebEngineDownloadRequest):
+        """Prompt for save location, accept download, and show in tray."""
+        default_name = download.downloadFileName() or "download"
+        path, _ = QFileDialog.getSaveFileName(
+            self.window(), "Save File", str(DOCUMENTS_DIR / default_name)
+        )
+        if not path:
+            download.cancel()
+            return
+
+        download.setDownloadDirectory(os.path.dirname(path))
+        download.setDownloadFileName(os.path.basename(path))
+        download.accept()
+
+        self.setVisible(True)
+        row = _DownloadRow(download, self._list_widget)
+        self._rows.append(row)
+        # Insert before stretch
+        self._list_layout.insertWidget(self._list_layout.count() - 1, row)
+        count = len([r for r in self._rows if r.isVisible()])
+        self._title.setText(f"Downloads ({count})")
+
+    def remove_row(self, row: _DownloadRow):
+        if row in self._rows:
+            self._rows.remove(row)
+        if not self._rows:
+            self.setVisible(False)
+        else:
+            self._title.setText(f"Downloads ({len(self._rows)})")
